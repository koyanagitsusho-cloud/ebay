# ─────────────────────────────────────────────────────────────────
# eBay自動化ツール 環境変数テンプレート
# このファイルを .env にコピーして各自の値を設定してください。
# .env は絶対にGitにコミットしないこと（.gitignoreに追加済み）
# ─────────────────────────────────────────────────────────────────

# ─── アプリ基本設定 ───
APP_NAME=eBay Automation Tool
ENVIRONMENT=development
DEBUG=false

# JWTシークレットキー（本番では必ずランダムな長い文字列を使用すること）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_change_this_in_production

# ─── データベース ───
# PostgreSQL接続URL（asyncpg使用）
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ebay_automation

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── eBay API設定 ───
# 重要: 最初は必ず sandbox から始めること！
# eBay Developer Portal (https://developer.ebay.com/) でアプリを作成して取得
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret

# リフレッシュトークンの取得方法:
# 1. eBay Developer PortalでOAuth同意フローを実行
# 2. 取得したリフレッシュトークンをここに設定
# 詳細: https://developer.ebay.com/api-docs/static/oauth-tokens.html
EBAY_REFRESH_TOKEN=your_ebay_refresh_token

# eBay APIスコープ（変更不要）
EBAY_SCOPES=https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.marketing https://api.ebay.com/oauth/api_scope/sell.account

# ─── AI設定 (Anthropic Claude) ───
# https://console.anthropic.com/ でAPIキーを取得
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3

# ─── ビジネスルール ───
# 最低利益率（15%）。この値を下回る価格での出品・値下げをブロック
DEFAULT_PROFIT_RATE_MIN=0.15

# 最低利益額（円）。この値を下回る利益での出品をブロック
DEFAULT_PROFIT_AMOUNT_MIN=500.0

# eBay手数料率（13.25%）。カテゴリにより異なる場合があるため要確認
DEFAULT_EBAY_FEE_RATE=0.1325

# 決済手数料率（2.9%）
DEFAULT_PAYPAL_FEE_RATE=0.029

# 為替レート（円/USD）。定期的に更新すること
# 将来的に外部APIで自動更新する予定
DEFAULT_EXCHANGE_RATE_JPY_USD=150.0

# ─── 安全装置 ───
# デフォルトでdry-runモードを有効にする（強く推奨）
DRY_RUN_DEFAULT=true

# 出品公開に承認を必須にする
REQUIRE_APPROVAL_FOR_PUBLISH=true

# 価格変更に承認を必須にする
REQUIRE_APPROVAL_FOR_PRICE_CHANGE=true

# ─── ジョブ設定 ───
JOB_MAX_RETRIES=3
JOB_RETRY_DELAY_SECONDS=60

# ─── ログ設定 ───
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_SENSITIVE_MASK=true

# ─── CORS ───
# Next.jsフロントエンドのURL（本番では適切なドメインに変更すること）
CORS_ORIGINS=["http://localhost:3000"]
